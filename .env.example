# Copy this file to .env and fill in your own project's values.
# See README.md "Setup" for how to obtain each of these.

# --- Supabase (client-safe, VITE_-prefixed so the browser can read them) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Supabase (server-side reads of the same project) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# --- Supabase service-role key — SERVER-ONLY. Never prefix with VITE_. ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Google AI Studio Gemini API key — server-only ---
GEMINI_API_KEY=
